# Copy to .env and adjust. DRY_RUN=true is the safe default.
# NEVER commit .env — it is gitignored.

# Solana RPC (public endpoint is rate-limited; use Helius/QuickNode for live)
RPC_URL=https://api.mainnet-beta.solana.com

# Strategy
BUY_AMOUNT_SOL=0.05
MAX_BUY_AMOUNT_SOL=0.25
TAKE_PROFIT_PCT=10
STOP_LOSS_PCT=25
SLIPPAGE_BPS=100
DRY_RUN=true

# Risk filters (also editable via `bot filters set`)
MAX_TOP_HOLDER_PCT=20
MAX_TOP10_HOLDER_PCT=50
MIN_LIQUIDITY_USD=10000
MIN_VOLUME_24H_USD=5000
MIN_VOLUME_SPIKE_RATIO=2.0
MIN_TOKEN_AGE_MINUTES=5
MAX_TOKEN_AGE_MINUTES=10080
REQUIRE_MINT_AUTHORITY_REVOKED=true
REQUIRE_FREEZE_AUTHORITY_REVOKED=true

# Optional APIs — run `npm run bot -- setup` to fill interactively
# Jupiter: https://portal.jup.ag/
# JUPITER_API_KEY=
# X/Twitter: https://developer.x.com/
# X_BEARER_TOKEN=
# xAI / Grok (Techno chat + optional trend assist): https://console.x.ai/
# XAI_API_KEY=
# GROK_API_KEY=          # alias for XAI_API_KEY
# XAI_MODEL=grok-4.7    # optional model override
# HELIUS_API_KEY=

# Scan loop
SCAN_INTERVAL_MS=30000
MAX_OPEN_POSITIONS=3
