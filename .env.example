# Copy to .env and adjust. DRY_RUN=true is the safe default.
# NEVER commit .env — it is gitignored.

# Solana RPC (public endpoint is rate-limited; use Helius/QuickNode for live)
RPC_URL=https://api.mainnet-beta.solana.com

# Strategy
BUY_AMOUNT_SOL=0.05
MAX_BUY_AMOUNT_SOL=0.25
MAX_PORTFOLIO_BUY_PCT=90
MIN_SOL_RESERVE=0.01
TAKE_PROFIT_PCT=10
STOP_LOSS_PCT=25
SLIPPAGE_BPS=100
DRY_RUN=true

# Risk filters (also editable via `bot filters set`)
MAX_TOP_HOLDER_PCT=20
MAX_TOP10_HOLDER_PCT=50
MAX_BUNDLER_PCT=-1
# Volume/spike gates: set to 0 to disable. Bundler: -1 disables (unknown never blocks).
MIN_LIQUIDITY_USD=10000
MIN_VOLUME_24H_USD=0
MIN_VOLUME_SPIKE_RATIO=0
MIN_TOKEN_AGE_MINUTES=5
MAX_TOKEN_AGE_MINUTES=10080
REQUIRE_MINT_AUTHORITY_REVOKED=true
REQUIRE_FREEZE_AUTHORITY_REVOKED=true

# Optional APIs — run `npm run bot -- setup` to fill interactively
# Jupiter: https://portal.jup.ag/
# JUPITER_API_KEY=
# X/Twitter: https://developer.x.com/
# X_BEARER_TOKEN=
# xAI / Grok (Techno chat + optional trend assist): https://console.x.ai/
# XAI_API_KEY=
# GROK_API_KEY=          # alias for XAI_API_KEY
# XAI_MODEL=grok-4.7    # optional model override
# HELIUS_API_KEY=
# Optional Solana Tracker bundler API (fallback when RugCheck fails)
# SOLANA_TRACKER_API_KEY=

# Scan loop
SCAN_INTERVAL_MS=30000
MAX_OPEN_POSITIONS=3

# Confluence / skill ranking (soft; defaults keep live bot fed)
MIN_CONFLUENCE_SOURCES=1
MAX_VOLUME_TO_LIQUIDITY_RATIO=40
PREFER_GRADUATED=true

# Search keywords: buzz words AND/OR Solana mint (contract) addresses
# Comma or space separated. Mints match candidates exactly (case-insensitive).
# Example: TWITTER_KEYWORDS=pump,solana,gem,moon,SoMeBase58MintAddressHere111111111111111
# TWITTER_KEYWORDS=
# SEARCH_KEYWORDS=          # alias for TWITTER_KEYWORDS
# AUTO_WATCH_OPEN_MINTS=true   # also watch open-position mints transiently
# AUTO_WATCH_HOT_MINTS=false   # also watch top hot-scan mints transiently

# Prefer Pump.fun callouts / launches when ranking tryEnter
PREFER_PUMP_CALLOUTS=true

# Experimental risk-on test: disable holder/authority/confluence hard gates;
# enter on bullish candle/indicator setups. Portfolio caps + TP/SL remain.
# RISK_ON_TEST=false
# MIN_PATTERN_SCORE=58
# MIN_CONFLUENCE_SOURCES=0
# PREFER_GRADUATED=false
